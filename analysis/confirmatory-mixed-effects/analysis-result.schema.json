{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cape-loop:schema:confirmatory-mixed-effects-result:v3",
  "title": "CAPE-Loop confirmatory mixed-effects result",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "experiment": {
            "const": "A"
          }
        },
        "required": [
          "experiment"
        ]
      },
      "then": {
        "properties": {
          "reference_updater": {
            "const": "exact_action_aware"
          },
          "outcome": {
            "const": "calibration_residual"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "experiment": {
            "const": "B"
          }
        },
        "required": [
          "experiment"
        ]
      },
      "then": {
        "properties": {
          "reference_updater": {
            "const": "fitted_action_aware"
          },
          "outcome": {
            "const": "terminal_error"
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "analysis_id",
    "experiment",
    "status",
    "claim_status",
    "source_run_ids",
    "target_updater",
    "reference_updater",
    "outcome",
    "formula",
    "family",
    "link",
    "estimation",
    "input",
    "fit",
    "contrast_families",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "analysis_id": {
      "const": "cape-loop-confirmatory-mixed-effects-v3"
    },
    "experiment": {
      "enum": [
        "A",
        "B"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "not_confirmatory",
        "not_estimable"
      ]
    },
    "claim_status": {
      "const": "not_claimed"
    },
    "source_run_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_updater": {
      "type": "string",
      "minLength": 1
    },
    "reference_updater": {
      "enum": [
        "exact_action_aware",
        "fitted_action_aware"
      ]
    },
    "outcome": {
      "enum": [
        "calibration_residual",
        "terminal_error"
      ]
    },
    "formula": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "const": "gaussian"
    },
    "link": {
      "const": "identity"
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "reml",
        "optimizer",
        "maxfun",
        "degrees_of_freedom",
        "confidence_level",
        "singularity_tolerance",
        "gradient_tolerance",
        "gradient_scaling",
        "minimum_user_clusters",
        "minimum_scenario_clusters"
      ],
      "properties": {
        "method": {
          "const": "maximum_likelihood"
        },
        "reml": {
          "const": false
        },
        "optimizer": {
          "const": "bobyqa"
        },
        "maxfun": {
          "type": "integer",
          "minimum": 1
        },
        "degrees_of_freedom": {
          "const": "Satterthwaite"
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "singularity_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
      "gradient_tolerance": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "gradient_scaling": {
        "const": "inverse_cholesky_hessian"
      },
        "minimum_user_clusters": {
          "type": "integer",
          "minimum": 2
        },
        "minimum_scenario_clusters": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "normalized_rows_sha256",
        "observation_count",
        "user_cluster_count",
        "scenario_cluster_count"
      ],
      "properties": {
        "manifest": {
          "const": "input-manifest.json"
        },
        "normalized_rows_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_count": {
          "type": "integer",
          "minimum": 1
        },
        "user_cluster_count": {
          "type": "integer",
          "minimum": 2
        },
        "scenario_cluster_count": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "fit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_class",
            "observation_count",
            "log_likelihood",
            "degrees_of_freedom",
            "aic",
            "bic",
            "residual_sigma"
          ],
          "properties": {
            "model_class": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observation_count": {
              "type": "integer",
              "minimum": 1
            },
            "log_likelihood": {
              "type": "number"
            },
            "degrees_of_freedom": {
              "type": "number",
              "minimum": 1
            },
            "aic": {
              "type": "number"
            },
            "bic": {
              "type": "number"
            },
            "residual_sigma": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "contrast_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "confirmatory_role",
          "contrast_count",
          "multiplicity",
          "contrast_ids"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "confirmatory_role": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "contrast_count": {
            "type": "integer",
            "minimum": 1
          },
          "multiplicity": {
            "const": "Holm within family"
          },
          "contrast_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostics",
        "analysis_rows",
        "fixed_effects",
        "omnibus_tests",
        "random_effects",
        "contrasts",
        "session_info",
        "checksums"
      ],
      "properties": {
        "diagnostics": {
          "const": "diagnostics.json"
        },
        "analysis_rows": {
          "const": "analysis-rows.csv"
        },
        "fixed_effects": {
          "const": "fixed-effects.csv"
        },
        "omnibus_tests": {
          "const": "omnibus-tests.csv"
        },
        "random_effects": {
          "const": "random-effects.csv"
        },
        "contrasts": {
          "const": "contrasts.csv"
        },
        "session_info": {
          "const": "session-info.txt"
        },
        "checksums": {
          "const": "SHA256SUMS"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
