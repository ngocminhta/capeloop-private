{
  "$id": "urn:cape-loop:schema:heldout-paraphrase-evaluation:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "belief_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "brier": {
      "maximum": 2,
      "minimum": 0,
      "type": "number"
    },
    "case_id": {
      "minLength": 1,
      "type": "string"
    },
    "domain_id": {
      "minLength": 1,
      "type": "string"
    },
    "family_id": {
      "minLength": 1,
      "type": "string"
    },
    "mechanism": {
      "enum": [
        "balanced",
        "restricted",
        "ranking",
        "default",
        "suggested"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "source_trial_id": {
      "minLength": 1,
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "development",
        "test"
      ]
    },
    "template_id": {
      "minLength": 1,
      "type": "string"
    },
    "updater_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "binding_sha256",
    "source_trial_id",
    "template_id",
    "family_id",
    "split",
    "domain_id",
    "mechanism",
    "updater_id",
    "brier",
    "belief_sha256"
  ],
  "title": "CAPE-Loop held-out paraphrase updater evaluation",
  "type": "object"
}
