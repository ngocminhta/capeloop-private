{
  "$id": "urn:cape-loop:schema:run-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_origin": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "config_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "descriptor": {
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "programmatic"
            }
          },
          "required": [
            "kind",
            "descriptor",
            "config_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "config_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "kind": {
              "const": "toml_file"
            },
            "retained_file": {
              "const": "config.source.toml"
            },
            "source_filename": {
              "minLength": 1,
              "type": "string"
            },
            "source_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "retained_file",
            "source_filename",
            "source_sha256",
            "config_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "deterministic": {
      "type": "boolean"
    },
    "git_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "conversation_templates": {
          "additionalProperties": false,
          "properties": {
            "bank_id": {
              "minLength": 1,
              "type": "string"
            },
            "input_kind": {
              "const": "conversation_template_bank"
            },
            "retained_file": {
              "const": "inputs/conversation-templates.json"
            },
            "scenario_count": {
              "minimum": 1,
              "type": "integer"
            },
            "schema_version": {
              "const": 1
            },
            "source": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "input_kind",
            "bank_id",
            "source",
            "scenario_count",
            "retained_file"
          ],
          "type": "object"
        },
        "scenario_catalog": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "catalog_status": {
                    "const": "frozen-development"
                  }
                },
                "required": [
                  "catalog_status"
                ]
              },
              "then": {
                "properties": {
                  "eligibility": {
                    "const": "simulation-and-pilot-only"
                  },
                  "paper_eligible": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "catalog_status": {
                    "const": "frozen-paper"
                  }
                },
                "required": [
                  "catalog_status"
                ]
              },
              "then": {
                "properties": {
                  "eligibility": {
                    "const": "paper-eligible"
                  },
                  "paper_eligible": {
                    "const": true
                  }
                }
              }
            }
          ],
          "properties": {
            "catalog_id": {
              "minLength": 1,
              "type": "string"
            },
            "catalog_status": {
              "enum": [
                "frozen-development",
                "frozen-paper"
              ]
            },
            "catalog_version": {
              "minLength": 1,
              "type": "string"
            },
            "eligibility": {
              "enum": [
                "simulation-and-pilot-only",
                "paper-eligible"
              ]
            },
            "family_count": {
              "minimum": 1,
              "type": "integer"
            },
            "input_kind": {
              "const": "scenario_catalog"
            },
            "paper_eligible": {
              "type": "boolean"
            },
            "retained_file": {
              "const": "inputs/scenario-catalog.json"
            },
            "scenario_count": {
              "minimum": 1,
              "type": "integer"
            },
            "schema_version": {
              "const": 1
            },
            "selection_policy": {
              "const": "deterministic-stratified-v1"
            },
            "source_filename": {
              "minLength": 1,
              "type": "string"
            },
            "source_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "input_kind",
            "catalog_id",
            "catalog_version",
            "catalog_status",
            "eligibility",
            "selection_policy",
            "source_filename",
            "source_sha256",
            "retained_file",
            "scenario_count",
            "family_count",
            "paper_eligible"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "created",
        "complete",
        "failed"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "config_sha256",
    "config_origin",
    "git_revision",
    "source_sha256",
    "deterministic",
    "status"
  ],
  "title": "CAPE-Loop run manifest",
  "type": "object"
}
