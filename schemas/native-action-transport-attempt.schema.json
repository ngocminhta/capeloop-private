{
  "$id": "urn:cape-loop:schema:native-action-transport-attempt:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A durable started or settled physical OpenAI HTTP-attempt event, bound to the reviewed native-action collection plan.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "attempt_ordinal": {
          "minimum": 1,
          "type": "integer"
        },
        "client_request_id": {
          "minLength": 1,
          "type": "string"
        },
        "collection_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "collection_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "estimated_max_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "event": {
          "const": "started"
        },
        "idempotency_key": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "native-action-transport-attempt"
        },
        "model_requested": {
          "minLength": 1,
          "type": "string"
        },
        "native_state_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "request_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "suite_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "event",
        "attempt_id",
        "collection_plan_sha256",
        "collection_config_sha256",
        "request_id",
        "prompt_sha256",
        "native_state_id",
        "suite_sha256",
        "request_body_sha256",
        "model_requested",
        "idempotency_key",
        "client_request_id",
        "estimated_max_tokens",
        "attempt_ordinal",
        "started_at"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "charged_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "event": {
          "const": "settled"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "const": "native-action-transport-attempt"
        },
        "outcome": {
          "enum": [
            "transport_error",
            "http_error",
            "invalid_response",
            "model_mismatch",
            "success"
          ]
        },
        "provider_audit": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "acceptance_status": {
                  "enum": [
                    "accepted",
                    "rejected_model_mismatch"
                  ]
                },
                "action_record": {
                  "additionalProperties": false,
                  "properties": {
                    "action_execution_mode": {
                      "enum": [
                        "recorded_live",
                        "recorded_replay"
                      ]
                    },
                    "actions": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "declared_direction": {
                            "anyOf": [
                              {
                                "enum": [
                                  -1,
                                  1
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "item_id": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "item_sha256": {
                            "pattern": "^[0-9a-f]{64}$",
                            "type": "string"
                          },
                          "question_type": {
                            "enum": [
                              "forced_choice",
                              "counterfactual_choice",
                              "direct_preference_probe",
                              "cross_context_choice"
                            ]
                          },
                          "selected_option_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "wording_template_id": {
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "item_id",
                          "item_sha256",
                          "wording_template_id",
                          "question_type",
                          "selected_option_id",
                          "declared_direction"
                        ],
                        "type": "object"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "adapter_kind": {
                      "const": "native_end_to_end_recorded"
                    },
                    "domain_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "evaluation_split": {
                      "const": "test"
                    },
                    "evidence_origin": {
                      "const": "imported_native_system"
                    },
                    "execution_trace_sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "native_state_id": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "native_system_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "native_system_version": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "record_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "record_sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "recorded_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "recording_attestation": {
                      "const": "actions_emitted_by_named_native_system_not_reference_projection"
                    },
                    "schema_version": {
                      "const": 1
                    },
                    "suite_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "suite_sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "trajectory_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "updater_id": {
                      "enum": [
                        "episodic_memory",
                        "semantic_memory",
                        "provenance_linked_memory"
                      ]
                    }
                  },
                  "required": [
                    "schema_version",
                    "record_id",
                    "trajectory_id",
                    "domain_id",
                    "updater_id",
                    "evaluation_split",
                    "adapter_kind",
                    "evidence_origin",
                    "native_state_id",
                    "native_system_id",
                    "native_system_version",
                    "suite_id",
                    "suite_sha256",
                    "action_execution_mode",
                    "execution_trace_sha256",
                    "recorded_at",
                    "recording_attestation",
                    "actions",
                    "record_sha256"
                  ],
                  "type": "object"
                },
                "attempts": {
                  "minimum": 1,
                  "type": "integer"
                },
                "client_request_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "completed_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "estimated_max_tokens": {
                  "minimum": 1,
                  "type": "integer"
                },
                "idempotency_key": {
                  "minLength": 1,
                  "type": "string"
                },
                "model_requested": {
                  "minLength": 1,
                  "type": "string"
                },
                "model_returned": {
                  "minLength": 1,
                  "type": "string"
                },
                "native_state_id": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "prompt_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "provider": {
                  "const": "openai"
                },
                "provider_response_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "raw_response": {
                  "type": "object"
                },
                "raw_response_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "request_body_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "request_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "schema_version": {
                  "const": 1
                },
                "server_request_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "started_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "suite_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "trajectory_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "usage": {
                  "type": "object"
                },
                "workflow": {
                  "const": "native_terminal_actions"
                }
              },
              "required": [
                "schema_version",
                "provider",
                "workflow",
                "acceptance_status",
                "request_id",
                "trajectory_id",
                "prompt_sha256",
                "native_state_id",
                "suite_sha256",
                "request_body_sha256",
                "model_requested",
                "model_returned",
                "provider_response_id",
                "usage",
                "started_at",
                "completed_at",
                "attempts",
                "idempotency_key",
                "client_request_id",
                "server_request_id",
                "estimated_max_tokens",
                "raw_response_sha256",
                "raw_response",
                "action_record"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_body_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_record": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": 1
        },
        "server_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "settled_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "event",
        "attempt_id",
        "settled_at",
        "outcome",
        "http_status",
        "charged_tokens",
        "server_request_id",
        "response_body_sha256",
        "response_record",
        "provider_audit"
      ],
      "type": "object"
    }
  ],
  "title": "CAPE-Loop native-action transport attempt"
}
