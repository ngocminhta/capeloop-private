{
  "$id": "urn:cape-loop:schema:heldout-paraphrase-criterion:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Outcome-neutral held-out surface readiness. Null verification means required case/updater coverage is incomplete; fitted-aware Brier gaps are retained only as secondary diagnostics.",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "covered_domains": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "covered_template_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "criterion_id": {
      "const": "held-out-paraphrase-transfer"
    },
    "expected_template_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "gate_1_argument": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "invariance_failures": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "material_gap": {
      "minimum": 0,
      "type": "number"
    },
    "mean_gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "domain_id": {
            "minLength": 1,
            "type": "string"
          },
          "family_id": {
            "minLength": 1,
            "type": "string"
          },
          "full_context_minus_aware_brier": {
            "type": "number"
          },
          "mechanism": {
            "enum": [
              "balanced",
              "restricted",
              "ranking",
              "default",
              "suggested"
            ]
          }
        },
        "required": [
          "family_id",
          "domain_id",
          "mechanism",
          "full_context_minus_aware_brier"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "missing_pairs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "qualifying_mechanisms": {
      "items": {
        "enum": [
          "balanced",
          "restricted",
          "ranking",
          "default",
          "suggested"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "required_mechanisms": {
      "minimum": 1,
      "type": "integer"
    },
    "response_invariant": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 2
    },
    "secondary_missing_pairs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "verified": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "criterion_id",
    "verified",
    "complete",
    "response_invariant",
    "invariance_failures",
    "material_gap",
    "required_mechanisms",
    "covered_domains",
    "covered_template_ids",
    "expected_template_ids",
    "qualifying_mechanisms",
    "mean_gaps",
    "missing_pairs",
    "secondary_missing_pairs",
    "gate_1_argument"
  ],
  "title": "CAPE-Loop Gate 1 held-out paraphrase criterion",
  "type": "object"
}
