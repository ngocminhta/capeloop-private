# Naming reference only: the CLI does not auto-load this file.
# Export the needed value in your shell and never commit a real credential.
OPENAI_API_KEY=

# Shared-gateway key for first-class OpenRouter profile-writer and
# reviewed-generic decoder collection through https://openrouter.ai/api.
# Export this name in the invoking shell; this file is not loaded automatically.
# Routed calls never count as direct first-party Gate 4 provenance, even when
# router metadata names an Anthropic, Google, or OpenAI upstream.
OPENROUTER_API_KEY=

# First-party keys for the two distinct-family Gate 4 decoder sources.
# The CLI reads these only after an explicit --execute-live authorization.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional dedicated names for separately reviewed custom endpoints. These are
# examples only; never reuse a first-party key or one variable across providers.
CAPE_LOOP_OPENAI_PROXY_KEY=
CAPE_LOOP_OPENROUTER_PROXY_KEY=
CAPE_LOOP_ANTHROPIC_PROXY_KEY=
CAPE_LOOP_GEMINI_PROXY_KEY=
